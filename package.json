{
  "name": "anybuy-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "AnyBuy - All-In-One E-Commerce Marketplace (Frontend & Backend)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run --prefix frontend dev",
    "dev:backend": "npm run --prefix backend start:dev",
    "build": "npm run --prefix backend build && npm run --prefix frontend build",
    "build:frontend": "npm run --prefix frontend build",
    "build:backend": "npm run --prefix backend build",
    "install:all": "npm install && npm run --prefix frontend install && npm run --prefix backend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
