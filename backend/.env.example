# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anybuy_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="anybuy-super-secure-jwt-secret-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="anybuy-super-secure-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRATION="7d"

# Frontend Client URL (For CORS and redirect links)
FRONTEND_URL="http://localhost:3000"

# Cookie Security
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
